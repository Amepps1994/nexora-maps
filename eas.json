{
  "cli": { "version": ">= 16.0.0", "appVersionSource": "remote" },
  "build": {
    "base": {
      "node": "22.20.0",
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://nexora-api-cfoh.onrender.com"
      }
    },
    "preview": {
      "extends": "base",
      "environment": "preview",
      "distribution": "internal",
      "android": { "buildType": "apk" }
    },
    "production-apk": {
      "extends": "base",
      "environment": "production",
      "distribution": "internal",
      "autoIncrement": true,
      "android": { "buildType": "apk" }
    }
  }
}
