# NEXORA Maps: non-secret development configuration only.
# Hosted OSRM endpoints are for modest non-commercial tests, not production.
# Enforce an application-wide rate strictly below 1 request/second across profiles.
# Endpoint availability and walking/cycling behaviour must be verified before enabling modes.
NEXORA_CAR_ROUTER=https://routing.openstreetmap.de/routed-car
NEXORA_FOOT_ROUTER=https://routing.openstreetmap.de/routed-foot
NEXORA_BIKE_ROUTER=https://routing.openstreetmap.de/routed-bike
# Exclude classes your OWN car graph was built with (e.g. motorway,toll,ferry).
# Leave empty for the hosted test graph: it rejects every exclude (probe 27 Nov 2026).
NEXORA_CAR_EXCLUDE=

# Deliberately unset: configure a licensed geocoder or an approved self-hosted index.
# Do not silently default to public nominatim.openstreetmap.org or use it for autocomplete.
# Supported: NEXORA_GEOCODER_PROVIDER=locationiq (URL defaults to https://eu1.locationiq.com/v1/search;
# free plan requires the in-app "Search by LocationIQ.com" link, which the app shows),
# or a licensed/self-hosted Nominatim-compatible URL (key sent as a Bearer token).
NEXORA_GEOCODER_PROVIDER=
NEXORA_GEOCODER_URL=
NEXORA_GEOCODER_KEY=

# Live London road disruptions (TfL Unified API, free under TfL's open data licence).
# Fetched server-side only and cached for 2 minutes. Works without a key at low volume;
# register a free app key at https://api-portal.tfl.gov.uk and put it in your private .env.
# The key is sent only to TfL and never returned to the app. Set NEXORA_TFL_DISABLED=1 to turn off.
NEXORA_TFL_APP_KEY=
NEXORA_TFL_DISABLED=

# Put any later credential in a private server environment/secret manager, never in
# this tracked file, an EXPO_PUBLIC_* variable, the client bundle or WebView HTML.
# No native live guidance, offline graph or live traffic speeds are enabled by these values.
# TfL disruptions are authority reports for London roads, not congestion or speeds.
